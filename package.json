{
  "name": "neon-ingvy-audio-plugins",
  "private": true,
  "description": "Audio plugins and Schwung modules around shared Rust engines; this workspace is the documentation site and the Move's web editors.",
  "license": "GPL-3.0-or-later",
  "workspaces": [
    "site",
    "web/kit",
    "web/trance-gate",
    "web/side-chain"
  ],
  "scripts": {
    "build": "npm run build --workspace site",
    "test:quick": "scripts/test.sh quick",
    "test:full": "scripts/test.sh full",
    "test:product": "scripts/test.sh product",
    "build:web": "scripts/build-web.sh",
    "test:web": "node --conditions=browser --test web/kit/test/*.test.mjs web/trance-gate/test/*.test.mjs web/side-chain/test/*.test.mjs",
    "test:e2e": "playwright test --config web/e2e/playwright.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
