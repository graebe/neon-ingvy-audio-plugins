---
/*
 * What changed, per release. The text is the repository's CHANGELOG.md -- the
 * same file someone reads on GitHub -- rendered through the content collection
 * so it cannot drift from it.
 */
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const [entry] = await getCollection('changelog');
const { Content } = await render(entry);
---
<Base title="What's new" description="What changed in each release, per product, in plain words.">
  <p class="eyebrow">What's new</p>
  <div class="prose"><Content /></div>
</Base>

<style>
  .eyebrow { display: block; margin-bottom: var(--s3); }
  .prose :global(h2) { margin-top: var(--s6); }
  .prose :global(h3) { margin-top: var(--s6); }
</style>
