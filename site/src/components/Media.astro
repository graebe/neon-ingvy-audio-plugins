---
/*
 * One slot, four backends, filled in phases: a still now; the real editor in an
 * iframe, an audio A/B and a WASM demo later. Kept as one component so a plugin
 * page does not change shape when the sample improves.
 */
import { url } from '../lib/paths.js';
const { still, alt, caption } = Astro.props;
---
{still ? (
  <figure>
    <img src={url(still)} alt={alt} loading="lazy" />
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
) : (
  <figure class="pending">
    <div class="placeholder"><span class="eyebrow">Screenshot pending</span></div>
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
)}

<style>
  figure { margin: var(--s6) 0 0; }
  img, .placeholder {
    border: var(--hair) solid var(--line-100);
    border-radius: var(--radius-1);
    background: var(--bg-000);
  }
  .placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 856 / 660;
    max-width: 856px;
  }
  figcaption { margin-top: var(--s2); color: var(--ink-dim); font-size: 12px; }
</style>
