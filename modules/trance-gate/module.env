# What modules/_shared/{package,install}.sh need to know about this module.
# Sourced by bash; plain assignments only. tests/release.test.mjs holds these to
# module.json and the workspace, so a rename cannot leave one of them behind.

# The catalog ID. It names the directory on the device and the .so inside it
# (the chain host builds modules/audio_fx/<id>/<id>.so itself), so it must equal
# module.json's "id".
MODULE_ID=trance-gate
# What the scripts print.
MODULE_TITLE="NI Trance Gate"
# The Schwung vtable crate -- the engine's *-move member of the workspace.
MODULE_CRATE=tg-move
# What modules/_shared/test.sh runs on aarch64 Linux beside the tarball checks.
# The core and the vtable crate, never the capi crate on its own: asked for by
# name, it would be built with its default `shell` feature, and that would
# reach the vtable crate's test build too -- testing a .so that does not ship.
MODULE_TEST_CRATES="tg-core tg-move"
# The engine's C suites against its ABI and the golden render's md5.
MODULE_TEST_SCRIPT=engines/trance-gate/tests/run.sh
