build/
# The instrumented build, which scripts/coverage.sh keeps separate from build/
# on purpose: it is -O0, single-slice and has no NDEBUG, so an artefact from it
# must never be picked up and shipped by mistake.
build-coverage/
# Sanitizer builds (-DNI_SANITIZE=..., cmake/Sanitize.cmake): instrumented and
# single-slice, so never to be mistaken for a shipping build either.
build-tsan/
build-asan/
# The JUCE spike's builds: the iPlug2 reference build the fixtures are captured
# from, and the spike's own (tests/fixtures/iplug2/README.md, spike/UT2.md).
# spike/out holds the built spike bundle for the manual Live test -- a build
# product, rebuilt by the commands in spike/UT2.md, never a tracked file.
build-spike/
spike/out/
# The native UI's own builds (ui/CMakeLists.txt): build-ui, and one
# build-ui-<what> per agent or developer building at the same time, so no two
# builds share a tree.
build-ui/
build-ui-*/
# An instrumented binary run without LLVM_PROFILE_FILE set drops this wherever
# it happened to be started from.
*.profraw
*.profdata
*.pcm
.DS_Store
target/

node_modules/
# The review harness copies the built bundle in beside its page; the page,
# the mock and the audit are source, the copies are not. Per-plugin paths were
# spelled out here and went stale the moment a plugin was renamed.
plugins/*/ui/test/harness/assets/
plugins/*/ui/test/harness/fonts/

# The Schwung module build (cmake --build build --target schwung)
dist/

# THE EDITORS' BUILD OUTPUT. vite writes each plugin's resources/web from its
# ui/ at configure and build time; a tracked copy was a second source of truth
# that could disagree with ui/src and that every UI change had to remember to
# commit. cmake/EditorGuard.cmake stops a configure that has none.
plugins/*/resources/web/
