build/
# The instrumented build, which scripts/coverage.sh keeps separate from build/
# on purpose: it is -O0, single-slice and has no NDEBUG, so an artefact from it
# must never be picked up and shipped by mistake.
build-coverage/
# Sanitizer builds (-DNI_SANITIZE=..., cmake/Sanitize.cmake): instrumented and
# single-slice, so never to be mistaken for a shipping build either.
build-tsan/
build-asan/
# Any other build directory: one per person or agent building at the same
# time (scripts/test.sh --build <dir>), never a source.
build-*/
# An instrumented binary run without LLVM_PROFILE_FILE set drops this wherever
# it happened to be started from.
*.profraw
*.profdata
*.pcm
.DS_Store
target/

node_modules/

# The Schwung module build (cmake --build build --target schwung)
dist/

# The cross-build kit's build directories (scripts/build-<platform>.sh), which
# sit inside whichever project they build -- tools/cross/smoke has its own.
build-macos-*/
build-linux-*/
build-windows-*/

# WHAT THE iPLUG2 BUILD LEFT BEHIND in a checkout that had it. Git removes the
# tracked files when such a checkout moves past the removal, but not what was
# never tracked: the submodule's own checkout and the SDKs it downloaded into
# it, vite's output in each plugin's resources/web, and the web editors'
# harness copies. Ignored here so that none of it can be committed back by
# accident; delete the directories to tidy such a checkout.
external/iPlug2/
plugins/*/resources/
plugins/*/ui/
