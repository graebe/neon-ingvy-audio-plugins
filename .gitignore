build/
# The instrumented build, which scripts/coverage.sh keeps separate from build/
# on purpose: it is -O0, single-slice and has no NDEBUG, so an artefact from it
# must never be picked up and shipped by mistake.
build-coverage/
# Sanitizer builds (-DNI_SANITIZE=..., cmake/Sanitize.cmake): instrumented and
# single-slice, so never to be mistaken for a shipping build either.
build-tsan/
build-asan/
# An instrumented binary run without LLVM_PROFILE_FILE set drops this wherever
# it happened to be started from.
*.profraw
*.profdata
*.pcm
.DS_Store
target/

node_modules/
# The review harness copies the built bundle in beside its page; the page,
# the mock and the audit are source, the copies are not. Per-plugin paths were
# spelled out here and went stale the moment a plugin was renamed.
plugins/*/ui/test/harness/assets/
plugins/*/ui/test/harness/fonts/

# The Schwung module build (cmake --build build --target schwung)
dist/
