From e99815a0c9b13ba6c3f854ceb5f0b729fc1cf7c0 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Torben=20Gr=C3=A4ber?= <torbengraebergt@gmail.com>
Date: Wed, 30 Sep 2026 14:48:02 +0200
Subject: [PATCH 2/4] clap bus offsets

---
 IPlug/CLAP/IPlugCLAP.cpp | 50 +++++++++++++++-------------------------
 1 file changed, 18 insertions(+), 32 deletions(-)

diff --git a/IPlug/CLAP/IPlugCLAP.cpp b/IPlug/CLAP/IPlugCLAP.cpp
index c642814..1269cdb 100644
--- a/IPlug/CLAP/IPlugCLAP.cpp
+++ b/IPlug/CLAP/IPlugCLAP.cpp
@@ -288,48 +288,34 @@ clap_process_status IPlugCLAP::process(const clap_process* pProcess) noexcept
 #endif
   
   SetChannelConnections(ERoute::kInput, 0, MaxNChannels(ERoute::kInput), false);
-  SetChannelConnections(ERoute::kInput, 0, nIns, true);
 
-  if (nIns > 0)
+  // Each input bus starts where the VST3 and AU wrappers start it -- after the
+  // widest layout of the buses before it -- so a plug-in finds a sidechain on
+  // the same channel whatever the format and whatever the main bus's width
+  for (uint32_t i = 0, offset = 0; i < pProcess->audio_inputs_count; i++)
   {
-    // Copy and attach buffer pointers
+    auto bus = pProcess->audio_inputs[i];
+    const int nChans = static_cast<int>(bus.channel_count);
+    
+    SetChannelConnections(ERoute::kInput, offset, nChans, true);
+    
     if (format64)
     {
-      for (uint32_t i = 0, k = 0; i < pProcess->audio_inputs_count; i++)
-      {
-        auto bus = pProcess->audio_inputs[i];
-        
-        for (uint32_t j = 0; j < bus.channel_count; j++, k++)
-        {
-          mAudioIO64.Get()[k] = bus.data64[j];
-          
-          // For local tail processing check for non-zero inputs
-
-          if (localTail && insQuiet)
-            insQuiet = InputIsSilent(bus.data64[j], nFrames);
-        }
-      }
+      // For local tail processing check for non-zero inputs
+      for (uint32_t j = 0; j < bus.channel_count && localTail && insQuiet; j++)
+        insQuiet = InputIsSilent(bus.data64[j], nFrames);
       
-      AttachBuffers(ERoute::kInput, 0, nIns, mAudioIO64.Get(), nFrames);
+      AttachBuffers(ERoute::kInput, offset, nChans, bus.data64, nFrames);
     }
     else
     {
-      for (uint32_t i = 0, k = 0; i < pProcess->audio_inputs_count; i++)
-      {
-        auto bus = pProcess->audio_inputs[i];
-
-        for (uint32_t j = 0; j < bus.channel_count; j++, k++)
-        {
-          mAudioIO32.Get()[k] = bus.data32[j];
-          
-          // For local tail processing check for non-zero inputs
-          if (localTail && insQuiet)
-            insQuiet = InputIsSilent(bus.data32[j], nFrames);
-        }
-      }
+      for (uint32_t j = 0; j < bus.channel_count && localTail && insQuiet; j++)
+        insQuiet = InputIsSilent(bus.data32[j], nFrames);
       
-      AttachBuffers(ERoute::kInput, 0, nIns, mAudioIO32.Get(), nFrames);
+      AttachBuffers(ERoute::kInput, offset, nChans, bus.data32, nFrames);
     }
+    
+    offset += std::max(MaxNChannelsForBus(ERoute::kInput, static_cast<int>(i)), nChans);
   }
 
   SetChannelConnections(ERoute::kOutput, 0, MaxNChannels(ERoute::kOutput), false);
-- 
